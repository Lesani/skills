#!/bin/bash
# foundry_claude — Claude Code against Azure AI Foundry, every model on Foundry.
#
#   foundry_claude [claude args...]                 asks for a profile (gum), then runs via the LiteLLM proxy
#   foundry_claude --profile anthropic|openai ...   skip the question (FOUNDRY_PROFILE=… does the same)
#   foundry_claude --direct [claude args]           straight to Foundry's Anthropic endpoint (Claude only)
#   foundry_claude proxy up|down|reload|status|logs|probe
#
# Nothing is exported into the calling shell: the child environment is built with
# `env -u ...`, so a plain `claude` afterwards still uses the claude.ai subscription.
set -euo pipefail

CONF_DIR="${FOUNDRY_CLAUDE_DIR:-$HOME/.config/foundry-claude}"
ENV_FILE="$CONF_DIR/.env"
PROXY_URL="http://127.0.0.1:4000"

# Every variable any claude wrapper touches. All are unset for the child before
# this run's config is applied, so wrappers can never inherit each other's state.
CLAUDE_ENV_KEYS=(
  ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY ANTHROPIC_CUSTOM_HEADERS
  API_TIMEOUT_MS
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS
  CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY
  CLAUDE_CODE_USE_FOUNDRY ANTHROPIC_FOUNDRY_API_KEY ANTHROPIC_FOUNDRY_AUTH_TOKEN
  ANTHROPIC_FOUNDRY_RESOURCE ANTHROPIC_FOUNDRY_BASE_URL
  ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL
  ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL
  ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_FABLE_MODEL
  CLAUDE_PROVIDER_BADGE
)

die() { printf 'foundry_claude: %s\n' "$*" >&2; exit 1; }

load_env() {
  [ -r "$ENV_FILE" ] || die "missing $ENV_FILE"
  # shellcheck disable=SC1090
  set -a; . "$ENV_FILE"; set +a
  [ -n "${LITELLM_MASTER_KEY:-}" ] || die "LITELLM_MASTER_KEY is empty in $ENV_FILE"
  # FOUNDRY_RESOURCE may be a bare resource name or the full endpoint host/URL
  # shown under "Endpoints and keys". Normalise to a host and hand it to compose.
  FOUNDRY_HOST="${FOUNDRY_RESOURCE#https://}"; FOUNDRY_HOST="${FOUNDRY_HOST%%/*}"
  case "$FOUNDRY_HOST" in *.*) ;; "") ;; *) FOUNDRY_HOST="$FOUNDRY_HOST.services.ai.azure.com" ;; esac
  printf 'FOUNDRY_HOST=%s\nFOUNDRY_RESOURCE_SHORT=%s\n' "$FOUNDRY_HOST" "${FOUNDRY_HOST%%.*}" > "$CONF_DIR/compose.env"
}

need_creds() {
  [ -n "${FOUNDRY_RESOURCE:-}" ] && [ -n "${AZURE_AI_API_KEY:-}" ] \
    || die "FOUNDRY_RESOURCE / AZURE_AI_API_KEY not set — edit $ENV_FILE"
}

dc() { sudo -n docker compose --project-directory "$CONF_DIR" --env-file "$CONF_DIR/compose.env" -f "$CONF_DIR/compose.yaml" "$@"; }

proxy_up() {
  # Idempotent; docker.socket is socket-activated so this also starts the daemon.
  dc up -d --wait --quiet-pull >/dev/null 2>&1 || { dc up -d --wait; }
}

proxy_reload() {
  # litellm.yaml is read once at start; a config edit needs a restart.
  dc up -d >/dev/null 2>&1 || true
  dc restart >/dev/null 2>&1
  dc up -d --wait >/dev/null 2>&1 || { dc up -d --wait; }
}

claude_bin() {
  local c
  c=$(command -v claude 2>/dev/null || true)
  [ -n "$c" ] || c="$HOME/.local/bin/claude"
  [ -x "$c" ] || die "claude not found on PATH"
  printf '%s' "$c"
}

# Profiles: what the opus/sonnet/haiku/fable aliases resolve to. Every target
# must be a model_name in litellm.yaml. Override a single alias in .env with
# FOUNDRY_<PROFILE>_<ALIAS>_MODEL, e.g. FOUNDRY_OPENAI_OPUS_MODEL=gpt-5.6-terra.
PROFILES=(anthropic openai)

pins() {  # pins <profile>
  local P; P=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
  local o s h f
  case "$1" in
    anthropic) o=claude-opus-5;  s=claude-sonnet-5;  h=claude-haiku-4-5; f=claude-fable-5-1 ;;
    openai)    o=gpt-5.6-sol;    s=gpt-5.6-terra;    h=gpt-5.6-luna;     f=gpt-6-astra ;;
    *) die "unknown profile '$1' (${PROFILES[*]})" ;;
  esac
  local vo vs vh vf
  vo="FOUNDRY_${P}_OPUS_MODEL"; vs="FOUNDRY_${P}_SONNET_MODEL"; vh="FOUNDRY_${P}_HAIKU_MODEL"; vf="FOUNDRY_${P}_FABLE_MODEL"
  o="${!vo:-$o}"; s="${!vs:-$s}"; h="${!vh:-$h}"; f="${!vf:-$f}"
  printf '%s\n' \
    "ANTHROPIC_DEFAULT_OPUS_MODEL=$o" \
    "ANTHROPIC_DEFAULT_SONNET_MODEL=$s" \
    "ANTHROPIC_DEFAULT_HAIKU_MODEL=$h" \
    "ANTHROPIC_DEFAULT_FABLE_MODEL=$f" \
    "ANTHROPIC_MODEL=opus"
}

pick_profile() {  # --profile X | FOUNDRY_PROFILE | interactive gum | anthropic
  if [ -n "${FOUNDRY_PROFILE:-}" ]; then printf '%s' "$FOUNDRY_PROFILE"; return; fi
  if [ -t 0 ] && [ -t 1 ] && command -v gum >/dev/null; then
    gum choose --header "foundry_claude — model profile" \
      --cursor.foreground 3 --header.foreground 6 \
      "anthropic  (opus→claude-opus-5, sonnet→claude-sonnet-5, haiku→claude-haiku-4-5, fable→claude-fable-5-1)" \
      "openai     (opus→gpt-5.6-sol, sonnet→gpt-5.6-terra, haiku→gpt-5.6-luna, fable→gpt-6-astra)" \
      | awk '{print $1}'
    return
  fi
  printf 'anthropic'
}

run_claude() {  # run_claude VAR=VAL ... -- [claude args]
  local -a scrub=() config=()
  local k
  for k in "${CLAUDE_ENV_KEYS[@]}"; do scrub+=(-u "$k"); done
  while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do config+=("$1"); shift; done
  [ "$#" -gt 0 ] && shift
  exec env "${scrub[@]}" "${config[@]}" "$(claude_bin)" "$@"
}

probe() {
  need_creds
  proxy_reload
  echo "== Endpoint: https://$FOUNDRY_HOST =="
  getent hosts "$FOUNDRY_HOST" >/dev/null || die "$FOUNDRY_HOST does not resolve — copy the host from Endpoints and keys"
  echo "== Deployments on the resource (deployment name -> model) =="
  curl -s -m 15 -H "api-key: $AZURE_AI_API_KEY" \
    "https://${FOUNDRY_HOST%%.*}.openai.azure.com/openai/deployments?api-version=2023-03-15-preview" \
    | python3 -c 'import sys,json
try:
  for x in sorted(json.load(sys.stdin)["data"], key=lambda x: x["id"].lower()): print("  %-28s %s" % (x["id"], x.get("model","?")))
except Exception: print("  (listing unavailable)")'
  echo
  echo "== Every model_name in litellm.yaml, through the proxy =="
  local m r
  for m in $(sed -n 's/^ *- model_name: *//p' "$CONF_DIR/litellm.yaml"); do
    r=$(curl -s -m 60 -X POST "$PROXY_URL/v1/messages" \
      -H "Authorization: Bearer $LITELLM_MASTER_KEY" \
      -H "anthropic-version: 2023-06-01" -H "content-type: application/json" \
      -d "{\"model\":\"$m\",\"max_tokens\":8,\"messages\":[{\"role\":\"user\",\"content\":\"Say OK\"}]}" || true)
    if printf '%s' "$r" | command grep -q '"type": *"message"'; then
      printf '  [OK]   %s\n' "$m"
    else
      printf '  [FAIL] %s  %s\n' "$m" "$(printf '%s' "$r" | python3 -c 'import sys,json,re
raw=sys.stdin.read()
try:
  e=json.load(sys.stdin.__class__(raw)) if False else json.loads(raw); e=e.get("error",e); msg=str(e.get("message",e))
except Exception: msg=raw
try:  # LiteLLM wraps the upstream JSON inside the message text: pull the inner code/message
  inner=json.loads(msg[msg.index("{"):]); inner=inner.get("error",inner); msg=f"{inner.get(\"code\",\"\")} {inner.get(\"message\",msg)}"
except Exception: pass
print(re.sub(r"\s+"," ",msg)[:200])' 2>/dev/null)"
    fi
  done
  echo
  echo "Keep only [OK] entries. Alias targets per profile: \`pins\` in $(realpath "$0")."
  local pr; for pr in "${PROFILES[@]}"; do printf '  %-10s %s\n' "$pr" "$(pins "$pr" | sed 's/ANTHROPIC_DEFAULT_//; s/_MODEL=/=/' | tr '\n' ' ')"; done
}

main() {
  local profile="" direct=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --profile)   profile="$2"; shift 2 ;;
      --profile=*) profile="${1#--profile=}"; shift ;;
      --direct)    direct=1; shift ;;
      *) break ;;
    esac
  done
  case "${1:-}" in
    proxy)
      load_env
      case "${2:-}" in
        up)     proxy_up; echo "proxy listening on $PROXY_URL" ;;
        down)   dc down ;;
        reload) proxy_reload; echo "proxy reloaded" ;;
        status) dc ps ;;
        logs)   dc logs -f --tail=100 ;;
        probe)  probe ;;
        *)      die "usage: foundry_claude proxy up|down|reload|status|logs|probe" ;;
      esac
      return
      ;;
  esac
  load_env; need_creds
  if [ "$direct" = 1 ]; then
    # Native Foundry integration: Claude deployments only, so the profile is fixed.
    mapfile -t p < <(pins anthropic)
    run_claude \
      CLAUDE_CODE_USE_FOUNDRY=1 \
      ANTHROPIC_FOUNDRY_BASE_URL="https://$FOUNDRY_HOST/anthropic" \
      ANTHROPIC_FOUNDRY_API_KEY="$AZURE_AI_API_KEY" \
      CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
      CLAUDE_PROVIDER_BADGE="FOUNDRY" \
      "${p[@]}" -- "$@"
  fi
  [ -n "$profile" ] || profile=$(pick_profile)
  [ -n "$profile" ] || die "no profile chosen"
  mapfile -t p < <(pins "$profile")
  proxy_up
  # Experimental betas off: a session can switch to a non-Claude model at any
  # time, and those upstreams reject the beta tool-schema fields with 400.
  run_claude \
    ANTHROPIC_BASE_URL="$PROXY_URL" \
    ANTHROPIC_AUTH_TOKEN="$LITELLM_MASTER_KEY" \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1 \
    CLAUDE_PROVIDER_BADGE="FOUNDRY/$(printf '%s' "$profile" | tr '[:lower:]' '[:upper:]')" \
    "${p[@]}" -- "$@"
}
main "$@"
