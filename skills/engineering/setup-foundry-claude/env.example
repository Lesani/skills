# Copy to ~/.config/foundry-claude/.env, chmod 600. Never commit the real file.
FOUNDRY_RESOURCE=                       # bare name or the full host from "Endpoints and keys"
AZURE_AI_API_KEY=                       # Foundry portal → Endpoints and keys
LITELLM_MASTER_KEY=sk-CHANGE-ME         # openssl rand -hex 24
# Optional alias overrides (must be model_name entries in litellm.yaml)
# FOUNDRY_OPUS_MODEL=claude-opus-5
